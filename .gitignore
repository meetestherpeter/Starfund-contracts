# Build
/target/
target_local/
**/*.rs.bk
# Root Cargo.lock is intentionally tracked for reproducible builds.
.cargo/

# Local command outputs (generated)
build_output*.txt
test_output*.txt

# Local notes / PR scratch files
PR_DESCRIPTION.md
TODO.md

# Test snapshots (generated)
**/test_snapshots/
**/*.snap
**/*.snap.new

# Kiro agent workspace files (generated by AI tooling)
.kiro/agents/

# proptest / fuzzing artefacts (runtime-generated, NOT regression seeds)
# Note: escrow/proptest-regressions/ is intentionally tracked — proptest
# regression seeds must be committed for reproducible CI runs.
**/proptest-regressions/**/*.txt.tmp

node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store

# Scratch / captured output (do not recreate at repo root)
*.exe
*.pdb
ci_logs*.txt
ci_main.txt
out.txt
test_out*.log
commit_msg.txt
ghit-*.md

# Wave backlog scratch files (generated markdown)
drips*.md
